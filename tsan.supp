race:brc.c
race:obmalloc.c
race:object_stack.c
race:pycore_object_stack.h
race:pycore_freelist.h
race:_Py_brc_merge_refcounts
race:_Py_brc_queue_object
race:_Py_brc_*
race:^JPH::*
race:dictresize
race:PyDict_SetItem
race:type_get_doc
# So fast that CPython is struggling!
race:PyDict_SetDefaultRef
race:PyUnicode_DecodeFSDefaultAndSize
# Internal CPython 3.14t race in filesystem codec initialization
# Triggered by concurrent calls to os.fsdecode/os.fsencode
# See on CPython Issue #128137, #128013, #128021
race:PyUnicode_DecodeUTF8Stateful
# CPython Internal: Generic Attribute Setting (JIT/Warmup noise)
race:PyObject_GenericSetAttr
race:PyObject_GenericSetAttr.warm

# CPython Internal: String/Unicode Interning and Comparison
race:unicode_eq
race:PyUnicode_FromString
race:PyUnicode_New
race:bcmp

# CPython Internal: Object Initialization & Type Setup
race:PyObject_GC_Del
race:_PyExc_InitTypes
race:_PyTypes_Init

# CPython Internal: Threading & Lifecycle
race:do_start_joinable_thread
race:PyEval_EvalFrameDefault

# Ignore CPython 3.12 internal qsort/sorting race
race:^qsort$
race:^qsort_r$
race:python3.12

# Ignore known false positives in Python's object allocation
race:PyObject_GC_Del
race:PyObject_GC_Track
race:PyGC_Collect

# Ignore internal mimalloc races in the Python interpreter
race:mimalloc
race:_mi_heap_init
race:mi_pthread_done