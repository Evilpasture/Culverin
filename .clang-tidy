# Proposed Refinements
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  clang-analyzer-*,
  -clang-analyzer-security.insecureAPI.strcpy,
  readability-*,
  -readability-identifier-length,
  -readability-function-cognitive-complexity,
  performance-*,
  misc-*,
  -misc-unused-parameters,
  
  # Crucial for concurrency/low-level
  bugprone-suspicious-include,
  bugprone-multiple-new-line-before-fallback,
  
  # Remove if the "no-malloc" warnings get too noisy
  -cppcoreguidelines-no-malloc 

CheckOptions:
  # Allow slightly larger functions for unrolled loops/SIMD
  readability-function-size.LineThreshold: 800 
  # Strict snake_case for everything in the C API
  readability-identifier-naming.VariableCase: snake_case
  readability-identifier-naming.FunctionCase: snake_case
  readability-identifier-naming.ParameterCase: snake_case
  # Magic numbers: ignore 0, 1, 2, and common powers of 2 (4, 8, 16, 32, 64)
  readability-magic-numbers.IgnoredIntegerValues: "0;1;2;4;8;16;32;64;128;256;512;1024"